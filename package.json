{
  "name": "docsnx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test-server": "next dev -p 3005",
    "dev": "next dev --turbo",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "migrate": "node scripts/check_migration_state.mjs && npx drizzle-kit migrate && npx tsx scripts/seed_document_category_fields.ts && node scripts/apply-rls.js",
    "release": "npm run build && npm run migrate && sudo systemctl restart docsnx",
    "start": "next start",
    "lint": "eslint",
    "update-context": "node scripts/update-context.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
